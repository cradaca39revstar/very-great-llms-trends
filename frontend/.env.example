# Copy to .env.local and fill with values from Terraform (or AWS Console).
# Do not commit .env.local.

# Cognito (existing User Pool and App Client)
# terraform output -raw cognito_user_pool_id
VITE_COGNITO_USER_POOL_ID=
# terraform output -raw cognito_client_id
VITE_COGNITO_CLIENT_ID=
# e.g. us-east-1 (same region as API Gateway)
VITE_AWS_REGION=us-east-1

# API Gateway endpoint (includes /trending-products/query)
# terraform output -raw api_gateway_url
VITE_API_URL=
