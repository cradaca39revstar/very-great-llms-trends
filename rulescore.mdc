return error_response.model_dump_json(by_alias=True)
```

#### 🔧 **Lambda Handler Pattern**
```python
@log_handler(domain="module_name")
def lambda_handler(event, context):
    """Lambda entrypoint - use @log_handler"""
    return process_request(event)

@log()
def process_request(event):
    """Internal function - use @log"""
    # Business logic here
    log_message("Processing completed")
    return result
```

#### 📄 **Pagination Request Pattern**
```python
class FetchItemsRequest(BasePaginatedRequestModel):
    """Paginated request with validation."""
    tenant_id: str
    status: Optional[str] = None
    
    @field_validator("order_by")
    @classmethod
    def validate_order_fields(cls, v):
        allowed_fields = {"created_at", "updated_at", "name"}
        # Validation logic here
        return v
```

#### 📊 **Pagination Response Pattern**
```python
class ItemData(BaseResponseModel):
    name: str
    uuid: str
    
    @classmethod
    def from_entity(cls, item: Item) -> "ItemData":
        return cls(name=item.name, uuid=item.uuid)

class FetchItemsResponse(BasePaginatedResponseModel[ItemData]):
    @classmethod
    def from_entity(cls, items: List[Item], **pagination_metadata) -> "FetchItemsResponse":
        return cls.create(
            data=[ItemData.from_entity(item) for item in items],
            **pagination_metadata
        )
```

#### 🗄️ **Repository Pattern**
```python
def fetch_items(self, filters: dict, pagination_params: dict) -> Tuple[List[Item], dict]:
    """Repository method returning (data, metadata) tuple."""
    
    # Build pagination query
    pagination_result = pagination_query(pagination_params)
    
    # Execute query
    items = self.execute_query(query, params)
    
    # Calculate metadata
    pagination_metadata = calculate_pagination_metadata(
        total_items=total_count,
        current_page=pagination_params["page"],
        page_size=pagination_params["page_size"],
        current_items_count=len(items)
    )
    
    return items, pagination_metadata
```

### 🚨 **Error Code Patterns**
- **Module Codes**: `USR001`, `CNT002`, `DOC003`, `AGT004`
- **Validation Codes**: `VALIDATION_MISSING`, `VALIDATION_INVALID`
- **Generic Codes**: `GENERIC_ERROR`, `INTERNAL_ERROR`

### 🔍 **Status Code Usage**
```python
# Success responses
HTTPStatus.OK.value                    # 200 - Success
HTTPStatus.CREATED.value              # 201 - Created
HTTPStatus.NO_CONTENT.value           # 204 - Deleted

# Client error responses  
HTTPStatus.BAD_REQUEST.value          # 400 - Validation error
HTTPStatus.UNAUTHORIZED.value         # 401 - Authentication error
HTTPStatus.FORBIDDEN.value            # 403 - Authorization error
HTTPStatus.NOT_FOUND.value            # 404 - Resource not found
HTTPStatus.CONFLICT.value             # 409 - Resource conflict

# Server error responses
HTTPStatus.INTERNAL_SERVER_ERROR.value # 500 - Internal error
```

### ⚡ **Performance Tips**
- Use cursor pagination for datasets > 10,000 records
- Index columns used in `order_by` clauses
- Limit `page_size` to maximum of 100
- Use `BasePaginatedRequestModel` for automatic validation
- Always include `request_id` for debugging

### 🧪 **Testing Patterns**
