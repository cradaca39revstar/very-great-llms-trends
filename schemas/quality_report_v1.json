{
  "schema_name": "data_quality_report",
  "version": "1.0.0",
  "description": "Schema for data quality reports generated by ETL jobs",
  "last_updated": "2024-01-17",
  "structure": {
    "job_run_id": {
      "type": "STRING",
      "description": "Unique identifier for the ETL job run",
      "example": "jr_20240417_123456",
      "required": true
    },
    "execution_timestamp": {
      "type": "STRING (ISO 8601)",
      "description": "Timestamp when the job was executed in UTC",
      "example": "2024-04-17T12:34:56Z",
      "required": true
    },
    "source_file": {
      "type": "STRING",
      "description": "S3 path to the source file processed",
      "example": "s3://very-great-products-raw-us-east-1-poc/landing/beauty-products/2024/04/17/products.csv",
      "required": true
    },
    "total_records": {
      "type": "INTEGER",
      "description": "Total number of records read from source",
      "example": 10000,
      "required": true
    },
    "records_passed": {
      "type": "INTEGER",
      "description": "Number of records with quality score >= 0.95",
      "example": 8500,
      "required": true
    },
    "records_warned": {
      "type": "INTEGER",
      "description": "Number of records with quality score 0.70-0.95",
      "example": 1200,
      "required": true
    },
    "records_failed": {
      "type": "INTEGER",
      "description": "Number of records with quality score < 0.70 (sent to quarantine)",
      "example": 300,
      "required": true
    },
    "records_duplicates": {
      "type": "INTEGER",
      "description": "Number of duplicate records removed",
      "example": 50,
      "required": false
    },
    "records_anomalies": {
      "type": "INTEGER",
      "description": "Number of records flagged as anomalies",
      "example": 10,
      "required": false
    },
    "pass_rate": {
      "type": "DECIMAL",
      "description": "Percentage of records that passed quality checks (0.0-1.0)",
      "example": 0.85,
      "required": true
    },
    "quality_issues": {
      "type": "OBJECT (key-value pairs)",
      "description": "Breakdown of quality issues by type with counts",
      "example": {
        "INVALID_DATE": 50,
        "SYNTHETIC_PRODUCT_ID": 150,
        "NEGATIVE_REVENUE": 30,
        "DUPLICATE_RECORD": 70
      },
      "required": true
    },
    "avg_quality_score": {
      "type": "DECIMAL",
      "description": "Average data quality score across all records",
      "example": 0.9234,
      "required": true
    },
    "transformation_version": {
      "type": "STRING",
      "description": "Version of transformation logic applied",
      "example": "v1.0.0",
      "required": true
    }
  },
  "sample_report": {
    "job_run_id": "jr_20240417_123456",
    "execution_timestamp": "2024-04-17T12:34:56Z",
    "source_file": "s3://very-great-products-raw-us-east-1-poc/landing/beauty-products/2024/04/17/products.csv",
    "total_records": 10000,
    "records_passed": 8500,
    "records_warned": 1200,
    "records_failed": 300,
    "records_duplicates": 50,
    "records_anomalies": 10,
    "pass_rate": 0.85,
    "quality_issues": {
      "INVALID_DATE": 50,
      "SYNTHETIC_PRODUCT_ID": 150,
      "NEGATIVE_REVENUE": 30,
      "DUPLICATE_RECORD": 70,
      "MISSING_ITEMS": 45,
      "SUSPICIOUS_GROWTH": 25
    },
    "avg_quality_score": 0.9234,
    "transformation_version": "v1.0.0"
  },
  "storage": {
    "format": "JSON",
    "location": "s3://very-great-products-processed-us-east-1-poc/quality-reports/beauty-products/YYYY/MM/DD/",
    "naming_convention": "report_{job_run_id}.json"
  },
  "usage": {
    "athena_table": "beauty_products_metadata_db.data_quality_metrics",
    "query_example": "SELECT * FROM beauty_products_metadata_db.data_quality_metrics WHERE avg_quality_score < 0.90 ORDER BY execution_timestamp DESC"
  }
}
